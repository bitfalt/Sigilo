# Copy to .env at the repo root. apps/web/.env.local is a symlink to it, so Next.js and
# `npx convex dev` read (and write) the same file. Never commit real values.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser.

# --- Network (Monad testnet, chain 10143) ---
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# --- Passkeys (Mera) ---
# rpId = the hostname passkeys bind to. `localhost` in dev; the FINAL production domain in prod.
# Changing it later orphans every account.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RP_NAME=Sigilo

# --- Server keys (server-only, testnet) ---
# Operator: publishes registry roots, relays worker-signed payments, pays MPP settlement gas.
OPERATOR_PRIVATE_KEY=
# Demo employer treasury (custodial, holds AUSD, calls SigiloPay.disperse).
TREASURY_PRIVATE_KEY=
# Demo lender key used by the lender console's MPP client and to fund the AdvanceVault.
LENDER_PRIVATE_KEY=
# Foundry deployments.
DEPLOYER_PRIVATE_KEY=

# --- App backend ---
SESSION_SECRET=
# MPP challenge secret (≥ 32 bytes, server-only).
MPP_SECRET_KEY=
# Written by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Deployed contracts (fill after `forge script` deploys) ---
NEXT_PUBLIC_SIGILO_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSPORT_VERIFIER_ADDRESS=
NEXT_PUBLIC_SIGILO_PAY_ADDRESS=
NEXT_PUBLIC_ADVANCE_VAULT_ADDRESS=
