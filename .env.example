# Copy to .env (root, used by scripts/Foundry) and apps/web/.env.local (Next.js).
# Never commit real values. Anything prefixed NEXT_PUBLIC_ is shipped to the browser.

# --- Network (Monad testnet, chain 10143) ---
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com

# --- Passkeys (Mera) ---
# rpId = the hostname passkeys bind to. `localhost` in dev; the FINAL production domain in prod.
# Changing it later orphans every account.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RP_NAME=Sigilo

# --- Unlink (server-only) ---
# Create a project for Monad testnet at https://dashboard.unlink.xyz → API Keys.
UNLINK_API_KEY=
# Custodial employer treasury account for the demo employer (BIP-39 mnemonic, server-only).
UNLINK_TREASURY_MNEMONIC=

# --- Sigilo operator (server-only) ---
# Publishes registry roots, receives MPP verification fees, drips testnet MON to new workers.
OPERATOR_PRIVATE_KEY=
# Demo lender key used by the lender console's MPP client.
LENDER_PRIVATE_KEY=
# Foundry deployments.
DEPLOYER_PRIVATE_KEY=

# --- App backend ---
DATABASE_URL=postgres://user:password@host:5432/sigilo
SESSION_SECRET=

# --- Deployed contracts (fill after `forge script` deploys) ---
NEXT_PUBLIC_SIGILO_REGISTRY_ADDRESS=
NEXT_PUBLIC_PASSPORT_VERIFIER_ADDRESS=
NEXT_PUBLIC_ADVANCE_VAULT_ADDRESS=

# --- Tokens (fill after spikes S3/S4) ---
# AUSD (or Unlink mock token) used for payroll on Monad testnet.
NEXT_PUBLIC_PAYROLL_TOKEN_ADDRESS=
