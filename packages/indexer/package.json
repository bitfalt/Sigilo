{
  "name": "@sigilo/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Envio HyperIndex indexer for Sigilo on Monad testnet: payroll, spending, advances, and what the public record reveals.",
  "type": "module",
  "scripts": {
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "typecheck": "envio codegen && tsc --noEmit",
    "test": "envio codegen && vitest run",
    "snapshot:testnet": "node scripts/snapshot-testnet.ts",
    "test:testnet": "envio codegen && vitest run test/testnet-replay.test.ts"
  },
  "dependencies": {
    "envio": "3.14.1",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
