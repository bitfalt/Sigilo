pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {HonkVerifier} from "../src/generated/HonkVerifier.sol";
import {IncomePassportVerifier} from "../src/IncomePassportVerifier.sol";
import {SigiloRegistry} from "../src/SigiloRegistry.sol";

/// @dev Uses a real proof generated by `pnpm --filter @sigilo/circuits prove:fixture`.
contract IncomePassportVerifierTest is Test {
    HonkVerifier internal honk;
    SigiloRegistry internal registry;
    IncomePassportVerifier internal passport;
    address internal operator = makeAddr("operator");

    bytes internal proof;
    bytes32[] internal publicInputs;

    function setUp() public {
        string memory json = vm.readFile("test/fixtures/income_passport.json");
        proof = vm.parseJsonBytes(json, ".proof");
        publicInputs = vm.parseJsonBytes32Array(json, ".publicInputs");

        honk = new HonkVerifier();
        registry = new SigiloRegistry(operator);
        passport = new IncomePassportVerifier(honk, registry);
    }

    function _publishFixtureRoot() internal {
        vm.prank(operator);
        registry.publishRoot(publicInputs[0]);
    }

    function test_honkVerifier_acceptsRealProof() public view {
        assertTrue(honk.verify(proof, publicInputs));
    }

    function test_verify_trueForKnownRoot() public {
        _publishFixtureRoot();
        uint256 gasBefore = gasleft();
        assertTrue(passport.verify(proof, publicInputs));
        emit log_named_uint("verify gas", gasBefore - gasleft());
    }

    function test_verify_falseForUnpublishedRoot() public view {
        assertFalse(passport.verify(proof, publicInputs));
    }

    function test_verify_falseForTamperedThreshold() public {
        _publishFixtureRoot();
        publicInputs[4] = bytes32(uint256(300_000));
        assertFalse(passport.verify(proof, publicInputs));
    }

    function test_verify_falseForTamperedProof() public {
        _publishFixtureRoot();
        proof[100] = bytes1(uint8(proof[100]) ^ 0x01);
        assertFalse(passport.verify(proof, publicInputs));
    }

    function test_verify_falseForWrongInputCount() public {
        _publishFixtureRoot();
        publicInputs.pop();
        assertFalse(passport.verify(proof, publicInputs));
    }

    function test_attest_emitsAndConsumesNonce() public {
        _publishFixtureRoot();
        IncomePassportVerifier.Passport memory expected = passport.decode(publicInputs);
        assertEq(expected.threshold, 150_000);
        assertEq(expected.firstPeriod, 2026 * 12 + 6);

        vm.expectEmit(true, true, false, true, address(passport));
        emit IncomePassportVerifier.PassportVerified(
            expected.scope,
            expected.pseudonym,
            expected.threshold,
            expected.firstPeriod,
            expected.nonce,
            expected.registryRoot
        );
        passport.attest(proof, publicInputs);
        assertTrue(passport.nonceUsed(keccak256(abi.encode(expected.scope, expected.nonce))));

        vm.expectRevert(IncomePassportVerifier.NonceAlreadyUsed.selector);
        passport.attest(proof, publicInputs);
    }

    function test_attest_revertsForUnknownRoot() public {
        vm.expectRevert(IncomePassportVerifier.UnknownRegistryRoot.selector);
        passport.attest(proof, publicInputs);
    }

    function test_attest_revertsForInvalidProof() public {
        _publishFixtureRoot();
        publicInputs[7] = bytes32(uint256(publicInputs[7]) ^ 1);
        vm.expectRevert(IncomePassportVerifier.InvalidProof.selector);
        passport.attest(proof, publicInputs);
    }

    function test_constructor_rejectsZeroAddresses() public {
        vm.expectRevert(IncomePassportVerifier.ZeroAddress.selector);
        new IncomePassportVerifier(honk, SigiloRegistry(address(0)));
    }
}
